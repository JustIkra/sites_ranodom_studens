# Production Environment Variables
# For deployment with Nginx Proxy Manager + ZeroTier on 172.30.4.14
#
# Instructions:
# 1. Copy this to .env: cp .env.production .env
# 2. Generate secure secret keys (see below)
# 3. Update ALLOWED_HOSTS when you add domain
# 4. Configure Nginx Proxy Manager to proxy to ports 8000 and 8001

# ======== SITEFINAL (Django + React SPA, port 8001) ========
FINAL_SECRET_KEY=CHANGE_ME_50_CHARS_RANDOM_STRING_FOR_SITEFINAL
DJANGO_ENV=production
DJANGO_DEBUG=0

# Allowed hosts: add your domain when configured in NPM
# Format: 172.30.4.14,yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=172.30.4.14

# CORS origins: update when domain is added
# Format: http://172.30.4.14,https://yourdomain.com,https://www.yourdomain.com
DJANGO_CORS_ORIGINS=http://172.30.4.14,http://172.30.4.14:8001

# CSRF trusted origins: update when domain is added
DJANGO_CSRF_TRUSTED_ORIGINS=http://172.30.4.14,http://172.30.4.14:8001

# Database: Leave commented to use SQLite, uncomment for MySQL
# MYSQL_DATABASE=sitefinal_db
# MYSQL_USER=sitefinal_user
# MYSQL_PASSWORD=secure_mysql_password_here
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# ======== VISITKA (Django templates app, port 8000) ========
VISITKA_SECRET_KEY=CHANGE_ME_50_CHARS_RANDOM_STRING_FOR_VISITKA
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=172.30.4.14

# ======== HOW TO GENERATE SECRET KEYS ========
# Run in Python:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

# ======== NGINX PROXY MANAGER CONFIGURATION ========
# After starting containers, configure in NPM UI:
#
# Proxy Host 1 (sitefinal - main site):
#   Domain: yourdomain.com (or use 172.30.4.14 initially)
#   Scheme: http
#   Forward Hostname/IP: 172.30.4.14
#   Forward Port: 8001
#   Cache Assets: Yes
#   Block Common Exploits: Yes
#   Websockets Support: No
#   SSL: Request Let's Encrypt cert (when domain is configured)
#
# Proxy Host 2 (visitka - learning logs):
#   Domain: visitka.yourdomain.com (or 172.30.4.14:8000)
#   Scheme: http
#   Forward Hostname/IP: 172.30.4.14
#   Forward Port: 8000
#   Cache Assets: Yes
#   Block Common Exploits: Yes
#   Websockets Support: No
#   SSL: Request Let's Encrypt cert (when domain is configured)

# ======== ZEROTIER NOTES ========
# Ensure 172.30.4.14 is your ZeroTier IP
# Members must be authorized in ZeroTier Central
# Ports 8000 and 8001 are accessible within ZT network
